# Copy this file to server/.env and fill in what you want to enable.
# Every feature here degrades gracefully if you skip it — the site
# and even most of the backend still work without any of this filled in.

# ---- Frontend origin (for CORS + where OAuth redirects back to) ----
FRONTEND_URL=http://localhost:5173
PORT=8787

# ---- Discord OAuth (required for admin login) ----
# Create an app at https://discord.com/developers/applications
# Add DISCORD_REDIRECT_URI as an exact match under OAuth2 > Redirects.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8787/auth/discord/callback

# Comma-separated Discord user IDs allowed into /admin.
# Right-click your own name in Discord (Developer Mode on) > Copy User ID.
ADMIN_DISCORD_IDS=

# Any long random string — used to sign the admin session cookie.
JWT_SECRET=

# ---- Firebase (optional — omit to use in-memory storage instead) ----
# Firebase Console > Project Settings > Service Accounts > Generate new key.
# Paste the values from that JSON file here.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Notifications on approve/deny (both optional, independent) ----
# A webhook URL from any channel: Channel Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL=

# A bot token, only if you want best-effort DMs to submitters.
# Requires the bot to share a server with the user.
DISCORD_BOT_TOKEN=

# ---- Existing: live bot stats (see README) ----
DISCORD_INVITE_CODE=7tSPQjtkhz
BOT_STATS_URL=
